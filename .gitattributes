# Normalize line endings
* text=auto eol=lf

# Godot files
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.import text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.svg text eol=lf
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff2 binary
